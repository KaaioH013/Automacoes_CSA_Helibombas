# Copie este arquivo para a RAIZ do projeto como .env
# (C:\DEV\Acesso_servidor\.env ou onde clonou o repo)

# --- Banco Sectra (SQL Server) ---
DB_SERVER=192.168.0.4
DB_PORT=1433
DB_DATABASE=INDUSTRIAL
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=SQL Server

# --- E-mail (Outlook Classic recomendado) ---
EMAIL_BACKEND=outlook
OUTLOOK_CONTA=comercial1@helibombas.com.br
OUTLOOK_SALVAR_RASCUNHO=false

# Destino padrao (alertas avulsos, previews)
ALERTAS_EMAIL_TO=comercial1@helibombas.com.br

